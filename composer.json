{
    "name": "wizhippo/ibexa-content-assistant",
    "description": "Schema-aware AI editor actions for Ibexa 5 using Symfony AI.",
    "type": "symfony-bundle",
    "license": "GPL-2.0-only",
    "homepage": "https://github.com/wizhippo/ibexa-content-assistant",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ibexa/admin-ui": "^5.0",
        "ibexa/core": "^5.0",
        "ibexa/fieldtype-richtext": "^5.0",
        "ibexa/twig-components": "^5.0",
        "symfony/ai-agent": "^0.15.0",
        "symfony/ai-bundle": "^0.15.0",
        "symfony/ai-open-responses-platform": "^0.15.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Wizhippo\\IbexaContentAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wizhippo\\IbexaContentAssistant\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Douglas Hammond",
            "homepage": "https://github.com/wizhippo",
            "role": "Author and maintainer"
        },
        {
            "name": "LLM",
            "role": "AI-assisted development"
        }
    ]
}
