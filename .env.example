# Copy these settings into the consuming application's local/deployment environment.
WIZHIPPO_IBEXA_CONTENT_ASSISTANT_ENABLED=0
WIZHIPPO_IBEXA_CONTENT_ASSISTANT_MODEL=gpt-6.1-terra
# Match this to the selected model; output budget is configured in bundle YAML.
WIZHIPPO_IBEXA_CONTENT_ASSISTANT_CONTEXT_WINDOW=1050000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# OpenRouter: also supply its API key above.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# WIZHIPPO_IBEXA_CONTENT_ASSISTANT_MODEL=openai/gpt-6.1-terra
